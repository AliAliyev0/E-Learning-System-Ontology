@prefix : <http://www.example.org/elearning-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.example.org/elearning-ontology> .

<http://www.example.org/elearning-ontology> rdf:type owl:Ontology ;
                                            owl:versionInfo "2.0 (Expanded)" ;
                                            rdfs:comment "E-Learning System Ontology expanded with institutional hierarchy and diverse learning materials (TBox)." .

# --- NESNE ÖZELLİKLERİ (OBJECT PROPERTIES) ---
:belongsToDepartment rdf:type owl:ObjectProperty ; rdfs:range :Department .
:offersProgram rdf:type owl:ObjectProperty ; rdfs:domain :Department ; rdfs:range :DegreeProgram .
:enrolledIn rdf:type owl:ObjectProperty ; owl:inverseOf :hasStudent ; rdfs:domain :Student ; rdfs:range :Course .
:hasStudent rdf:type owl:ObjectProperty ; rdfs:domain :Course ; rdfs:range :Student .
:hasAssignment rdf:type owl:ObjectProperty ; rdfs:domain :Course ; rdfs:range :Assignment .
:hasGrade rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :Submission ; rdfs:range :Grade .
:hasModule rdf:type owl:ObjectProperty ; rdfs:domain :Course ; rdfs:range :Module .
:hasPrerequisite rdf:type owl:ObjectProperty , owl:TransitiveProperty ; rdfs:domain :Course ; rdfs:range :Course .
:isTaughtBy rdf:type owl:ObjectProperty , owl:FunctionalProperty ; owl:inverseOf :teaches ; rdfs:domain :Course ; rdfs:range :Instructor .
:teaches rdf:type owl:ObjectProperty ; rdfs:domain :Instructor ; rdfs:range :Course .
:hasSubmission rdf:type owl:ObjectProperty ; owl:inverseOf :submissionFor ; rdfs:domain :Assignment ; rdfs:range :Submission .
:submissionFor rdf:type owl:ObjectProperty ; rdfs:domain :Submission ; rdfs:range :Assignment .
:submits rdf:type owl:ObjectProperty ; owl:inverseOf :submittedBy ; rdfs:domain :Student ; rdfs:range :Submission .
:submittedBy rdf:type owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :Submission ; rdfs:range :Student .

# --- VERİ ÖZELLİKLERİ (DATA PROPERTIES) ---
:credits rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Course ; rdfs:range xsd:integer .
:durationInWeeks rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Module ; rdfs:range xsd:integer .
:courseCode rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Course ; rdfs:range xsd:string .
:courseTitle rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Course ; rdfs:range xsd:string .
:dueDate rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Assignment ; rdfs:range xsd:dateTime .
:hasEmail rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Person ; rdfs:range xsd:string .
:hasName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Person ; rdfs:range xsd:string .
:score rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Grade ; rdfs:range xsd:float .
:submissionDate rdf:type owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Submission ; rdfs:range xsd:dateTime .

# --- SINIFLAR (CLASSES) ---
:Institution rdf:type owl:Class .
:Faculty rdf:type owl:Class ; rdfs:subClassOf :Institution .
:Department rdf:type owl:Class ; rdfs:subClassOf :Faculty .

:Person rdf:type owl:Class .
:Student rdf:type owl:Class ; rdfs:subClassOf :Person .
:Instructor rdf:type owl:Class ; rdfs:subClassOf :Person .
:TeachingAssistant rdf:type owl:Class ; rdfs:subClassOf :Person .

:AcademicContent rdf:type owl:Class .
:Course rdf:type owl:Class ; rdfs:subClassOf :AcademicContent .
:DegreeProgram rdf:type owl:Class ; rdfs:subClassOf :AcademicContent .
:Module rdf:type owl:Class ; rdfs:subClassOf :AcademicContent .

:VideoLecture rdf:type owl:Class ; rdfs:subClassOf :Module .
:ReadingMaterial rdf:type owl:Class ; rdfs:subClassOf :Module .
    
:Assessment rdf:type owl:Class .
:Assignment rdf:type owl:Class ; rdfs:subClassOf :Assessment .
:Quiz rdf:type owl:Class ; rdfs:subClassOf :Module , :Assessment .

:Evaluation rdf:type owl:Class .
:Grade rdf:type owl:Class ; rdfs:subClassOf :Evaluation .
:Submission rdf:type owl:Class .
